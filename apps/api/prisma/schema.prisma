// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Capacitaciones LMS
//
// Convenciones:
//  · Todos los IDs usan cuid() — distribuible, sin colisiones, URL-safe.
//  · Todas las tablas con tenant data tienen `tenantId` para multi-tenancy.
//  · Soft delete via `deletedAt DateTime?` — nunca borrar registros de usuarios.
//  · `createdAt` y `updatedAt` en todos los modelos.
//  · Row Level Security (RLS) se habilita en la migración — ver docs/rls.md
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

/// Roles en la plataforma. SUPER_ADMIN es exclusivo del equipo de la plataforma.
enum UserRole {
  SUPER_ADMIN // Equipo interno — acceso total, no pertenece a ningún tenant
  OWNER       // Quien contrató el plan — gestiona suscripción y admins
  ADMIN       // Administra usuarios, cursos y configuración del tenant
  MANAGER     // Supervisión de equipos y reportes de progreso
  EMPLOYEE    // Empleado / estudiante — solo consume contenido
}

enum PlanType {
  FREE
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING  // Período de prueba activo
  ACTIVE    // Suscripción paga y al día
  PAST_DUE  // Pago fallido, en período de gracia
  UNPAID    // Gracia expirada, acceso suspendido
  CANCELED  // Cancelada por el cliente o por falta de pago
}

enum CourseStatus {
  DRAFT      // Solo visible para admins
  PUBLISHED  // Visible y disponible para inscripción
  ARCHIVED   // Oculto del catálogo, pero conserva datos de progreso
}

enum LessonType {
  VIDEO // Video vía Mux
  TEXT  // Markdown / contenido enriquecido
  FILE  // Archivo descargable (PDF, ZIP, etc.)
}

enum EnrollmentStatus {
  ACTIVE    // Inscripción vigente
  COMPLETED // Completó todos los módulos
  DROPPED   // Abandonó el curso
}

enum ResetRequestStatus {
  PENDING  // Esperando revisión del admin
  APPROVED // Aprobada — intentos del usuario fueron reiniciados
  DENIED   // Rechazada por el admin
}

enum NotificationType {
  RESET_REQUEST    // Admin: estudiante solicita nueva oportunidad en quiz
  ENROLLMENT       // Admin: usuario se inscribe en un curso
  COURSE_COMPLETED // Admin: usuario completó un curso
  VIDEO_READY      // Usuario: su video terminó de procesar en Mux
  RESET_APPROVED   // Estudiante: admin aprobó su solicitud de reinicio
  RESET_DENIED     // Estudiante: admin rechazó su solicitud de reinicio
  QUIZ_ASSIGNED    // Empleado: le asignaron un quiz
  QUIZ_COMPLETED   // Admin/Manager: empleado completó un quiz
}

enum QuizAssignmentStatus {
  PENDING      // Asignado, no iniciado
  IN_PROGRESS  // Iniciado (timer activo si aplica)
  COMPLETED    // Enviado — solo 1 intento permitido
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

/// Planes de suscripción disponibles en la plataforma.
/// Administrado por el equipo interno — no editable por tenants.
model Plan {
  id          String   @id @default(cuid())
  type        PlanType @unique
  name        String
  description String?

  /// Precio mensual en USD. 0 para el plan FREE.
  priceUsd Decimal @db.Decimal(10, 2)

  // ── Límites del plan (-1 = ilimitado) ──────────────────────────────────────
  maxEmployees Int
  maxCompanies Int
  maxStorageGb Int

  // ── Feature flags ──────────────────────────────────────────────────────────
  hasEvaluations  Boolean @default(false)
  hasCertificates Boolean @default(false)
  hasAnalytics    Boolean @default(false)
  hasWhiteLabel   Boolean @default(false)
  hasApi          Boolean @default(false)

  // ── Stripe (null para FREE) ─────────────────────────────────────────────────
  stripePriceId   String? @unique
  stripeProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

/// Empresa / organización que contrata el servicio.
/// Es la unidad raíz de multi-tenancy.
/// parentTenantId no nulo = sub-empresa; hereda la suscripción del padre.
model Tenant {
  id       String  @id @default(cuid())
  name     String
  /// Identificador URL-friendly único. Ej: "acme-corp". Inmutable tras creación.
  slug     String  @unique
  /// Dominio personalizado. Solo disponible en plan Enterprise.
  domain   String? @unique
  logoUrl      String?
  /// Color primario de marca en hex (ej: "#1E4F7A"). Solo disponible en planes con hasWhiteLabel.
  primaryColor String?
  /// Nombre de la plataforma (reemplaza "Capta" en UI, título del browser y emails).
  /// Solo configurable en Enterprise con white-label.
  appName      String?
  isActive     Boolean @default(true)

  /// Si no es null, este tenant es una sub-empresa del tenant padre.
  parentTenantId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — preserva historial de facturación y progreso de empleados.
  deletedAt DateTime?

  parent   Tenant?  @relation("SubCompanies", fields: [parentTenantId], references: [id])
  children Tenant[] @relation("SubCompanies")

  users        User[]
  subscription Subscription?
  userInvites  UserInvite[]
  courses      Course[]
  enrollments  Enrollment[]
  quizzes      Quiz[]

  @@index([parentTenantId])
  @@map("tenants")
}

/// Usuario del sistema. Siempre pertenece a un tenant.
/// SUPER_ADMIN es la única excepción — su tenantId apunta a un tenant interno.
model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  /// 2FA / MFA — TOTP (RFC 6238). El secret se guarda cifrado con AES-256-GCM.
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  mfaBackupCodes String[] @default([]) // hashes bcrypt de 8 códigos de un solo uso

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — requerido por GDPR/compliance. El email se anonimiza aparte.
  deletedAt DateTime?

  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  refreshTokens        RefreshToken[]
  passwordResetRequests PasswordResetRequest[]
  sentInvites          UserInvite[]            @relation("SentInvites")
  courses              Course[]                @relation("CourseAuthor")
  enrollments          Enrollment[]
  createdQuizzes       Quiz[]                  @relation("QuizCreator")
  quizAssignments      QuizAssignment[]        @relation("QuizAssignee")
  quizAssignmentsGiven QuizAssignment[]        @relation("QuizAssigner")

  /// El email es único DENTRO de un tenant, no globalmente.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  // Compound index para queries de soft delete: WHERE tenantId = X AND deletedAt IS NULL
  @@index([tenantId, deletedAt])
  @@map("users")
}

/// Refresh tokens para rotación segura de sesiones JWT.
/// Se guarda el hash SHA-256, nunca el token en plano.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// Hash SHA-256 del token. El token real solo existe en el cliente.
  tokenHash String    @unique
  expiresAt DateTime
  /// Null = vigente. Populated = revocado (logout o rotación por sospecha).
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de un solo uso para recuperación de contraseña. Expira en 1 hora.
model PasswordResetRequest {
  id        String    @id @default(cuid())
  userId    String
  /// Hash SHA-256 del token. El token raw solo viaja por email — nunca se persiste.
  tokenHash String    @unique
  expiresAt DateTime
  /// Null = no utilizado todavía. Populated = ya fue utilizado (no reutilizable).
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_requests")
}

/// Suscripción activa de un tenant a un plan.
/// Relación 1:1 con Tenant — solo puede haber una suscripción activa por empresa.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  planId   String

  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /// Si true, no se renueva al final del período actual.
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?

  // ── Stripe (null para FREE) ─────────────────────────────────────────────────
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  plan         Plan                      @relation(fields: [planId], references: [id])
  storagePacks SubscriptionStoragePack[]

  @@index([tenantId])
  @@map("subscriptions")
}

/// Invitaciones de usuarios pendientes de activación.
model UserInvite {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        UserRole  @default(EMPLOYEE)
  firstName   String
  lastName    String
  /// Hash SHA-256 del token enviado por email.
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation("SentInvites", fields: [invitedById], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user_invites")
}

/// Registro de eventos de Stripe ya procesados para garantizar idempotencia en webhooks.
/// Stripe puede enviar el mismo evento más de una vez en reintentos.
model ProcessedStripeEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  eventType      String
  processedAt    DateTime @default(now())

  @@index([processedAt])
  @@map("processed_stripe_events")
}

// ─── STORAGE ADD-ONS ──────────────────────────────────────────────────────────

model StoragePack {
  id        String  @id @default(cuid())
  name      String
  storageGb Int
  priceUsd  Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  stripePriceId   String? @unique
  stripeProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionPacks SubscriptionStoragePack[]

  @@map("storage_packs")
}

model SubscriptionStoragePack {
  id             String @id @default(cuid())
  subscriptionId String
  storagePackId  String
  quantity       Int    @default(1)

  stripeSubscriptionItemId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  storagePack  StoragePack  @relation(fields: [storagePackId], references: [id])

  @@unique([subscriptionId, storagePackId])
  @@index([subscriptionId])
  @@map("subscription_storage_packs")
}

// ─── FASE 2: CORE LMS ─────────────────────────────────────────────────────────

/// Curso de capacitación perteneciente a un tenant.
/// Estructura: Course → CourseModule[] → Lesson[]
model Course {
  id           String       @id @default(cuid())
  tenantId     String
  /// Usuario que creó el curso (ADMIN u OWNER).
  authorId     String?
  title        String
  description  String?      @db.Text
  thumbnailUrl String?      // URL pública de la miniatura
  thumbnailKey String?      // Object key en MinIO para gestión del archivo
  status       CourseStatus @default(DRAFT)
  /// Contador desnormalizado — se actualiza al crear/eliminar lecciones.
  /// Permite mostrar el conteo sin hacer JOIN, mejorando el rendimiento.
  totalLessons Int          @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  author      User?          @relation("CourseAuthor", fields: [authorId], references: [id])
  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([tenantId])
  @@index([tenantId, status])
  // Compound index para soft delete: WHERE tenantId = X AND deletedAt IS NULL
  @@index([tenantId, deletedAt])
  @@map("courses")
}

/// Módulo dentro de un curso — agrupa lecciones relacionadas.
/// El campo `order` determina el orden de presentación (0-based).
model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  /// Desnormalizado para filtros RLS eficientes sin JOIN a Course.
  tenantId    String
  title       String
  description String?
  /// Posición dentro del curso. Los valores se reasignan al reordenar.
  order       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@index([courseId, deletedAt])
  @@map("course_modules")
}

/// Lección dentro de un módulo. Puede ser video, texto o archivo.
model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  /// Desnormalizado para filtros RLS eficientes sin JOIN a CourseModule.
  tenantId    String
  title       String
  /// Contenido en Markdown — solo aplica para type = TEXT.
  content     String?    @db.Text
  type        LessonType @default(TEXT)
  /// Posición dentro del módulo.
  order       Int        @default(0)
  /// Si true, el contenido es accesible sin inscripción (preview).
  isPreview   Boolean    @default(false)
  /// Duración estimada en segundos (real para videos, estimada para texto).
  duration    Int?

  // ── Archivo (MinIO/S3) ──────────────────────────────────────────────────────
  fileKey       String? // Object key en el bucket
  fileName      String? // Nombre original del archivo
  fileSizeBytes Int?
  fileMimeType  String?

  // ── Video (Mux) ────────────────────────────────────────────────────────────
  /// ID del asset en Mux — usado para gestión (eliminar, etc.).
  muxAssetId    String?
  /// ID de reproducción — se combina con el player de Mux para streaming.
  muxPlaybackId String?
  /// Estado del procesamiento: "preparing" | "ready" | "errored"
  muxStatus     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  module     CourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]
  evaluation Evaluation?

  @@index([moduleId])
  @@index([moduleId, deletedAt])
  @@map("lessons")
}

/// Inscripción de un usuario en un curso.
/// Un mismo usuario no puede inscribirse dos veces al mismo curso en el mismo tenant.
model Enrollment {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  /// Progreso general del 0 al 100. Se recalcula al completar cada lección.
  progress    Int              @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  course         Course           @relation(fields: [courseId], references: [id])
  lessonProgress LessonProgress[]
  certificate    Certificate?

  @@unique([tenantId, userId, courseId])
  @@index([tenantId])
  @@index([userId])
  @@map("enrollments")
}

/// Progreso por lección — registra qué lecciones completó cada estudiante.
/// Tabla pivote entre Enrollment y Lesson con datos de seguimiento.
model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  /// Desnormalizado para consultas rápidas por usuario.
  userId       String
  /// Desnormalizado para RLS.
  tenantId     String
  completedAt  DateTime?
  /// Segundos visualizados — para videos, permite retomar desde el punto exacto.
  watchedSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([userId])
  @@map("lesson_progress")
}

// ─── FASE 3: EVALUACIONES ─────────────────────────────────────────────────────

/// Evaluación (quiz) vinculada 1:1 a una lección.
/// Solo disponible en planes con hasEvaluations = true.
model Evaluation {
  id           String  @id @default(cuid())
  tenantId     String
  lessonId     String  @unique // 1 evaluación por lección
  title        String
  instructions String? @db.Text
  /// Porcentaje mínimo para aprobar (0–100).
  minScore     Int     @default(70)
  /// Intentos máximos permitidos. -1 = ilimitado.
  maxAttempts  Int     @default(3)
  /// Tiempo límite en segundos. null = sin límite.
  timeLimit    Int?
  /// Si true, el empleado debe aprobar para continuar al siguiente recurso.
  isRequired   Boolean @default(false)
  /// Si false, las respuestas correctas NO se revelan al reprobar teniendo intentos restantes.
  showAnswers  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson        Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      EvaluationAttempt[]
  resetRequests AttemptResetRequest[]

  @@index([tenantId])
  @@map("evaluations")
}

/// Pregunta de opción múltiple dentro de una evaluación.
model Question {
  id           String  @id @default(cuid())
  evaluationId String
  tenantId     String
  text         String  @db.Text
  /// Peso de la pregunta al calcular la puntuación final.
  points       Int     @default(1)
  order        Int     @default(0)
  /// Explicación que aparece al revisar resultados (puede ser null).
  explanation  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  options    QuestionOption[]
  answers    AttemptAnswer[]

  @@index([evaluationId])
  @@map("questions")
}

/// Opción de respuesta para una pregunta.
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId])
  @@map("question_options")
}

/// Intento de evaluación realizado por un usuario.
model EvaluationAttempt {
  id           String   @id @default(cuid())
  tenantId     String
  evaluationId String
  userId       String
  enrollmentId String
  /// Porcentaje de aciertos (0–100), calculado por el servidor.
  score        Int
  passed       Boolean
  completedAt  DateTime @default(now())

  createdAt DateTime @default(now())

  evaluation Evaluation    @relation(fields: [evaluationId], references: [id])
  answers    AttemptAnswer[]

  @@index([evaluationId, userId])
  @@index([tenantId])
  @@map("evaluation_attempts")
}

/// Respuesta de un usuario a una pregunta específica en un intento.
model AttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean

  attempt  EvaluationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])
  option   QuestionOption    @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

/// Solicitud de reinicio de intentos.
/// El estudiante la crea cuando agota sus intentos; el admin la aprueba o rechaza.
/// Al aprobar, se eliminan todos los EvaluationAttempt del usuario para esa evaluación.
model AttemptResetRequest {
  id           String             @id @default(cuid())
  tenantId     String
  evaluationId String
  userId       String
  /// Mensaje opcional del estudiante explicando por qué necesita otra oportunidad.
  message      String?            @db.Text
  status       ResetRequestStatus @default(PENDING)
  requestedAt  DateTime           @default(now())
  processedAt  DateTime?
  /// userId del admin que procesó la solicitud.
  processedBy  String?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, tenantId])
  @@index([userId])
  @@map("attempt_reset_requests")
}

/// Notificación persistente — se entrega también en tiempo real por WebSocket.
/// `data` contiene el contexto de navegación (courseId, lessonId, etc.) para el redirect al hacer click.
model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  /// ID del usuario receptor de la notificación.
  userId    String
  type      NotificationType
  title     String
  body      String
  /// JSON con contexto de navegación: courseId, lessonId, evaluationId, etc.
  data      Json?
  /// null = no leída. Populated = ya leída.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, tenantId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── FASE 3: CERTIFICADOS ─────────────────────────────────────────────────────

/// Certificado de finalización emitido al completar un curso al 100% o al aprobar un quiz.
/// Se genera automáticamente al completar el enrollment (curso) o al pasar el quiz.
model Certificate {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  /// null para certificados de quiz
  courseId         String?
  /// null para certificados de curso
  quizId           String?
  /// null para certificados de quiz. @unique → 1 certificado por inscripción.
  enrollmentId     String?   @unique
  /// null para certificados de curso. @unique → 1 certificado por asignación.
  quizAssignmentId String?   @unique
  /// UUID v4 público para verificación — no derivable del id interno.
  publicUuid       String    @unique @default(uuid())
  issuedAt         DateTime  @default(now())

  // Snapshot inmutable — preserva los datos aunque cambien el nombre del usuario,
  // el título del curso/quiz o el nombre de la empresa.
  recipientName String
  /// Título del curso o del quiz en el momento de la emisión.
  courseTitle   String
  tenantName    String

  createdAt DateTime @default(now())

  enrollment     Enrollment?     @relation(fields: [enrollmentId], references: [id])
  quizAssignment QuizAssignment? @relation(fields: [quizAssignmentId], references: [id])

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("certificates")
}

// ─── FASE 4: QUIZZES STANDALONE ───────────────────────────────────────────────
//
// A diferencia de Evaluation (vinculada 1:1 a una Lesson), un Quiz es una
// entidad independiente que el admin asigna directamente a empleados.
// Regla de negocio: un empleado solo tiene UNA oportunidad (maxAttempts = 1).

/// Quiz standalone — no vinculado a una lección ni a un curso.
/// Creado por ADMIN/OWNER para evaluar conocimiento o determinar necesidad de capacitación.
model Quiz {
  id           String  @id @default(cuid())
  tenantId     String
  title        String
  description  String? @db.Text
  instructions String? @db.Text
  /// Tiempo límite en segundos. null = sin límite.
  timeLimit    Int?
  /// Porcentaje mínimo para aprobar (0–100).
  minScore     Int     @default(70)
  isActive     Boolean @default(true)
  createdById  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  createdBy   User             @relation("QuizCreator", fields: [createdById], references: [id])
  questions   QuizQuestion[]
  assignments QuizAssignment[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("quizzes")
}

/// Pregunta de opción múltiple dentro de un Quiz standalone.
model QuizQuestion {
  id          String  @id @default(cuid())
  quizId      String
  tenantId    String
  text        String  @db.Text
  explanation String? @db.Text
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

/// Opción de respuesta para una QuizQuestion.
model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())

  question QuizQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@index([questionId])
  @@map("quiz_options")
}

/// Asignación de un Quiz a un empleado específico.
/// Un empleado solo puede tener una asignación por quiz (@@unique).
model QuizAssignment {
  id           String               @id @default(cuid())
  tenantId     String
  quizId       String
  userId       String
  assignedById String
  status       QuizAssignmentStatus @default(PENDING)
  dueDate      DateTime?
  assignedAt   DateTime             @default(now())
  startedAt    DateTime?

  quiz       Quiz         @relation(fields: [quizId], references: [id])
  user       User         @relation("QuizAssignee", fields: [userId], references: [id])
  assignedBy User         @relation("QuizAssigner", fields: [assignedById], references: [id])
  attempt    QuizAttempt?
  certificate Certificate?

  @@unique([quizId, userId])
  @@index([tenantId])
  @@index([tenantId, userId, status])
  @@map("quiz_assignments")
}

/// Intento único de un empleado en una asignación (maxAttempts = 1 por diseño).
model QuizAttempt {
  id           String    @id @default(cuid())
  tenantId     String
  assignmentId String    @unique
  userId       String
  quizId       String
  /// Porcentaje de aciertos (0–100), calculado al momento del submit.
  score        Int?
  passed       Boolean?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  assignment QuizAssignment     @relation(fields: [assignmentId], references: [id])
  answers    QuizAttemptAnswer[]

  @@index([tenantId, userId])
  @@map("quiz_attempts")
}

/// Respuesta del empleado a cada pregunta del quiz.
model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
  option   QuizOption   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

/// Registro inmutable de acciones críticas del sistema.
/// Se escribe de forma asíncrona (fire-and-forget) sin bloquear el response.
/// No se permite soft delete — los registros de auditoría son permanentes.
model AuditLog {
  id       String  @id @default(cuid())
  /// null cuando la acción ocurre antes de autenticar (ej. login fallido).
  userId   String?
  /// null para acciones de SUPER_ADMIN o en rutas pre-autenticación.
  tenantId String?
  /// Valor del enum AuditAction definido en audit.types.ts.
  action   String
  /// Nombre del modelo Prisma afectado: "User", "Course", "Tenant", etc.
  entity   String?
  /// ID del registro afectado.
  entityId String?
  /// Datos extra: email, valores anteriores/nuevos, conteos, etc.
  meta      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
