# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacitaciones_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Solo requerido en producción (docker-compose.prod.yml lo inyecta en el contenedor Redis)
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MFA (Autenticación de dos factores) ───────────────────────────────────────
# MFA_ENCRYPTION_KEY: clave AES-256-GCM para cifrar secrets TOTP en BD.
# Formato: exactamente 64 hex chars (32 bytes). Generar con: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# JWT exclusivo para tokens mfaPending (5 min). Generar con: openssl rand -base64 32
MFA_JWT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Obtener en: dashboard.stripe.com → Developers → API keys
# Test: sk_test_... | Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_...
# Obtener en: dashboard.stripe.com → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── MinIO (Object Storage S3-compatible) ──────────────────────────────────────
# Dev local: docker compose up -d (MinIO en localhost:9000, consola en :9001)
# Prod (opción A — MinIO en VPS): ENDPOINT=tu-dominio.com, PORT=443, USE_SSL=true
# Prod (opción B — Cloudflare R2): ENDPOINT=<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=lms-files
# URL base para URLs públicas de thumbnails y logos (sin slash al final)
STORAGE_PUBLIC_URL=http://localhost:9000/lms-files
# URL pública que MinIO usa para validar firmas de presigned URLs
# Dev: http://localhost:9000 | Prod: https://tu-dominio.com
STORAGE_SERVER_URL=http://localhost:9000

# ── Mux (streaming de video) ──────────────────────────────────────────────────
# Obtener en: dashboard.mux.com → Settings → Access Tokens → Generate new token
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Obtener en: dashboard.mux.com → Settings → Webhooks → tu endpoint → Signing secret
MUX_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Obtener en: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_...
# Requiere dominio verificado en Resend (resend.com → Domains)
EMAIL_FROM=noreply@tu-dominio.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5001

# ── Docker / CI-CD (solo para docker-compose.prod.yml y GitHub Actions) ───────
# Usuario u organización de GitHub que publica la imagen en ghcr.io
GITHUB_OWNER=tu-usuario-github
# Credenciales de PostgreSQL para el contenedor de producción
POSTGRES_USER=capta_user
POSTGRES_PASSWORD=
POSTGRES_DB=capta_db
