# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacitaciones_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_at_least_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_super_secret_refresh_key_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── MinIO (Object Storage S3-compatible) ──────────────────────────────────────
# Dev local: levantar con docker compose up -d (incluye MinIO en el stack)
# Prod: cambiar endpoint/keys por Backblaze B2 o AWS S3 — el SDK es el mismo
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=lms-files
# URL pública base para thumbnails y archivos accesibles sin auth
STORAGE_PUBLIC_URL=http://localhost:9000/lms-files

# ── Mux (streaming de video) ──────────────────────────────────────────────────
# Crear cuenta en mux.com → Settings → API Access Tokens
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@tudominio.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5001
