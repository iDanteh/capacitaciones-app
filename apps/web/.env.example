# URL del backend NestJS (accesible desde el browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# URL interna del backend para el middleware de Next.js (Edge/Node server-side).
# En Docker usa la red interna: http://api:5000/api/v1
# Si no se define, se usa NEXT_PUBLIC_API_URL como fallback.
# API_INTERNAL_URL=http://api:5000/api/v1

# Stripe (clave pública — segura para exponer en el cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
